				Locality_Name
				Pincode
				Active_Status
			)
		}
		default list Citizen_Registration_Report
		{
			displayName = "Citizen_Registration Report"
			show all rows from Citizen_Registration    
			(
				Citizen_ID
				Email
				Full_Name 
				Phone_Number1 as "Phone_Number"
				(
					displayformat = plainnumber 
				)
				Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				District
				Area_Locality_Master
				Registration_Date
				Account_Status
			)
		}
