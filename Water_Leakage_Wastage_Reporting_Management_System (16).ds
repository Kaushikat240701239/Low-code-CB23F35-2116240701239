				Issue
				Citizen
				Rating
				Comments
				Feedback_Date
				Follow_Up_Required
				Sentiment
			)
			group by
			(
				Sentiment ascending
			)
		}
		list Own_Citizen_Registration
		{
			displayName = "Own Citizen Registration"
			show all rows from Citizen_Registration  [Email == zoho.loginuserid]  
			(
				Citizen_ID
				Full_Name 
				Email
				Phone_Number1 as "Phone_Number"
				(
					displayformat = plainnumber 
				)
				Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				District
				Area_Locality_Master
				Registration_Date
				Account_Status
			)
			sort by
			(
				Registration_Date descending
			)
		}
		list My_Complaints
		{
			displayName = "My Complaints"
			show all rows from Water_Issue_Report    
			(
				Issue_ID
				Citizen
				Issue_Title
				Issue_Type
				Description
				District
				Area_Locality
				Street_Address
				Pincode
				Landmark
				Issue_Photo
				Report_Date
				Report_Time
				Severity
				Priority
				Status
				Assigned_Team
				Technician
				Expected_Resolution_Date
				Resolution_Notes
			)
		}
		list My_Feedback
		{
			displayName = "My  Feedback"
			show all rows from Feedback  [Citizen.Email == zoho.loginuserid]  
			(
				Feedback_ID
				Issue
				Citizen
				Rating
				Comments
				Feedback_Date
				Follow_Up_Required
				Sentiment
			)
		}
		list My_Complaints_User
		{
			displayName = "My Complaints"
			show all rows from Water_Issue_Report  [Citizen.Email == zoho.loginuserid]  
			(
				Issue_ID
				Issue_Title
				Issue_Type
				Area_Locality
				Report_Date
				Status
				Citizen
				Description
				District
				Street_Address
				Landmark
				Pincode
				Issue_Photo
				(
			dimension = thumbnail
				)
				Report_Time
				Priority
				Severity
				Assigned_Team
				Technician
				Expected_Resolution_Date
				Resolution_Notes
			)
			sort by
			(
				Report_Date descending
			)
		}
		pivotchart issue_type_split
		{
			displayname = "issue type split"
			based on Autoview_1793970124932_Water_Issue_Report
				show all rows from Water_Issue_Report
				(
			Issue_ID 
			Citizen 
			Issue_Title 
			Issue_Type 
			Description 
			District 
			Area_Locality 
				)
		}
	}
