		workflow
		{
		form
		{
			WF_Complaint_Submission_C as "WF_Complaint_Submission_Confirmation"
			{
				type =  form
				form = Water_Issue_Report

				record event = on add

				on success
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "zoho.loginuserid"
							subject : "Record Added"
							message : "<div>${zoho.loginuserid} has added a record in form Water_Issue_Report<br></div>"
							attachments : template : _default1 as inline
						)
					}
					actions 
					{
						custom deluge script
						(
											sendmail
										[
											from :zoho.adminuserid
											to :input.Citizen.Email
											subject :"Water Complaint Received"
											message :"Your water complaint has been submitted successfully.\n\nIssue ID: " + input.Issue_ID + "\nIssue: " + input.Issue_Title + "\nStatus: " + input.Status + "\n\nPlease use your account to track the complaint."
										]
						)
					}
				}

			}
			WF_Technician_Assignment as "WF_Technician_Assignment"
			{
				type =  form
				form = Water_Issue_Report

				record event = on edit

				on update of Technician
				{
					actions 
					{
						custom deluge script
						(
											if(input.Technician != null)
										{
											input.Status = "Assigned";
											sendmail
											[
												from :zoho.adminuserid
												to :input.Technician.Email
												subject :"New Water Repair Assignment"
												message :"A water complaint has been assigned to you.\n\nIssue ID: " + input.Issue_ID + "\nIssue: " + input.Issue_Title + "\nDistrict: " + input.District + "\nStatus: Assigned\n\nPlease open the application and review the complaint."
											]
										}
						)
					}
				}

			}
			WF_Repair_Progress as "WF_Repair_Progress"
			{
				type =  form
				form = Repair_Resolution

				record event = on edit

				on update of Repair_Status
				{
					actions 
					{
						custom deluge script
						(
											if(input.Issue != null)
										{
											complaint = Water_Issue_Report[ID == input.Issue];
											if(complaint.count() > 0)
											{
												if(input.Repair_Status == "In Progress")
												{
													complaint.Status="In Progress";
												}
												else if(input.Repair_Status == "On Hold")
												{
													complaint.Status="On Hold";
												}
												else if(input.Repair_Status == "Completed")
												{
													complaint.Status="Under Review";
													supervisorEmail = zoho.adminuserid;
													if(complaint.Assigned_Team != null)
													{
														team = Maintenance_Team[ID == complaint.Assigned_Team];
														if(team.count() > 0 && team.Supervisor_Email != null)
														{
															supervisorEmail = team.Supervisor_Email;
														}
													}
													technicianName = "Not assigned";
													if(input.Technician != null)
													{
														technicianName = input.Technician.Technician_Name.first_name;
													}
													sendmail
													[
														from :zoho.adminuserid
														to :supervisorEmail
														subject :"Repair Awaiting Verification"
														message :"A repair has been marked Completed and needs your verification.\n\nRepair ID: " + input.Repair_ID + "\nIssue ID: " + complaint.Issue_ID + "\nIssue: " + complaint.Issue_Title + "\nTechnician: " + technicianName + "\nAction Taken: " + ifnull(input.Action_Taken,"") + "\nRepair Cost: " + ifnull(input.Repair_Cost,"") + "\nWater Loss Estimate: " + ifnull(input.Water_Loss_Estimate,"") + "\n\nOpen Repair_Resolution to set Verification Status to Approved or Rework Required."
													]
												}
											}
										}
						)
					}
				}

			}
			WF_Repair_Verification as "WF_Repair_Verification"
			{
				type =  form
				form = Repair_Resolution

				record event = on edit

				on update of Verification_Status
				{
					actions 
					{
						custom deluge script
						(
											if(input.Issue != null)
										{
											issueRecord = Water_Issue_Report[ID == input.Issue];
											if(issueRecord.count() > 0)
											{
												if(input.Verification_Status == "Approved")
												{
													issueRecord.Status="Resolved";
													issueRecord.Resolution_Notes=input.Remarks;
													sendmail
													[
														from :zoho.adminuserid
														to :issueRecord.Citizen.Email
														subject :"Water Complaint Resolved"
														message :"Your water complaint has been marked Resolved after supervisor verification.\n\nIssue ID: " + issueRecord.Issue_ID + "\nIssue: " + issueRecord.Issue_Title + "\nResolution: " + input.Remarks + "\n\nYou can log in to the application and submit feedback."
													]
												}
												else if(input.Verification_Status == "Rework Required")
												{
													issueRecord.Status="In Progress";
													sendmail
													[
														from :zoho.adminuserid
														to :input.Technician.Email
														subject :"Repair Requires Further Work"
														message :"The supervisor has requested rework for Repair ID: " + input.Repair_ID + ". Please review the inspection results and update the repair."
													]
												}
											}
										}
						)
					}
				}

			}
			WF_Feedback_Follow_Up as "WF_Feedback_Follow_Up"
			{
				type =  form
				form = Feedback

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											if((input.Follow_Up_Required != null && input.Follow_Up_Required.contains("Checked")) || input.Rating == "1" || input.Rating == "2")
										{
											sendmail
											[
												from :zoho.adminuserid
												to :zoho.adminuserid
												subject :"Citizen Feedback Requires Follow-up"
												message :"A citizen has submitted feedback that requires attention.\n\nFeedback ID: " + input.Feedback_ID + "\nRating: " + input.Rating + "\nComments: " + ifnull(input.Comments,"") + "\n\nPlease review the feedback and contact the citizen if necessary."
											]
										}
						)
					}
				}

			}
			Supervisor_Verification_E as "Supervisor Verification Email"
			{
				type =  form
				form = Repair_Resolution

				record event = on edit

				on update of Repair_Status
				{
					actions 
					{
						custom deluge script
						(
											supervisorEmail = zoho.adminuserid;
										tech = Technician[ID == input.Technician];
										if(tech.count() > 0 && tech.Team != null)
										{
											team = Maintenance_Team[ID == tech.Team];
											if(team.count() > 0 && team.Supervisor_Email != null)
											{
												supervisorEmail = team.Supervisor_Email;
											}
										}
										sendmail
										[
											from :zoho.adminuserid
											to :supervisorEmail
											subject :"Repair Awaiting Verification"
											message :"A repair has been marked Completed and needs your verification.\n\nRepair ID: " + input.Repair_ID + "\n\nOpen Repair_Resolution to set Verification Status to Approved or Rework Required."
										]
						)
					}
				}

			}
		}

		schedule
		{
			WF_Daily_Overdue_Alert as "WF_Daily_Overdue_Alert"
			{
				type =  schedule
				start = "2026-10-20 09:00:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "zoho.adminuserid"
							subject : ""
							message : "<div><br></div>"
							attachments : view : Locality_wise_Issues as PDF
						)
					}
					actions 
					{
					on load
					(
						for each  issue in Water_Issue_Report[Expected_Resolution_Date < zoho.currentdate && Status != "Resolved" && Status != "Closed" && Status != "Rejected"]
										{
											sendmail
											[
												from :zoho.adminuserid
												to :zoho.adminuserid
												subject :"Overdue Water Complaint"
												message :"A water complaint is overdue.\n\nIssue ID: " + issue.Issue_ID + "\nIssue: " + issue.Issue_Title + "\nDistrict: " + issue.District + "\nStatus: " + issue.Status + "\nExpected resolution date: " + issue.Expected_Resolution_Date + "\n\nPlease review the complaint and follow up with the assigned technician."
											]
										}
					)
					}
				}
			}
		}



		batchworkflow
		{
			Daily_Assignment_and_Veri
			{
    			display name = "Daily Assignment and Verification Report"
    			type = batchworkflow
    			form = Water_Issue_Report
    			event = "On Schedule"
    			start = "06-Nov-2026 09:00:00"
    			frequency = daily
    			batch size = 1000
    			status = active
    			on execute 
    			{
					actions 
					{
						custom deluge script
						(
											unassigned = "";
										for each  c in Water_Issue_Report[Technician == null && Status != "Resolved" && Status != "Closed" && Status != "Rejected"]
										{
											unassigned = unassigned + c.Issue_ID + " | " + c.Issue_Title + " | " + c.District + " | Status: " + c.Status + "\n";
										}
										if(unassigned == "")
										{
											unassigned = "None\n";
										}
										unverified = "";
										for each  r in Repair_Resolution[Repair_Status == "Completed" && Verification_Status == "Pending"]
										{
											unverified = unverified + "Repair " + r.Repair_ID + " | Issue " + r.Issue.Issue_ID + " | " + r.Issue.Issue_Title + "\n";
										}
										if(unverified == "")
										{
											unverified = "None\n";
										}
										sendmail
										[
											from :zoho.adminuserid
											to :zoho.adminuserid
											subject :"Daily Report: Unassigned Complaints and Unverified Repairs"
											message :"UNASSIGNED COMPLAINTS (no technician assigned):\n" + unassigned + "\n\nUNVERIFIED REPAIRS (Completed, waiting for supervisor verification):\n" + unverified
										]
						)
					}
    			}
			}
		}

	}
	share_settings
	{
			"Read"
			{
				name = "Read"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have read permission for all components\n"
			}
			"Write"
			{
				name = "Write"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have write permission for all components\n"
			}
			"Technician_Permissions"
			{
				name = "Technician_Permissions"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Allows technicians to view assigned complaints and update repair records, materials used, and inspection results\n"
				ModulePermissions
				{
					Evidence_Subform
					{
						enabled= Create,Viewall,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							Evidence_Subform_Report={"View"}
						}
					}
					Citizen_Registration
					{
						allFieldsVisible= true 
					}
					Technician
					{
						enabled= Create,Viewall,Modifyall,Import,Export,Tab 
						ReportPermissions
						{
							Technician_Details={"View","Edit"}
							All_Technicians={"View","Edit"}
						}
						FieldPermissions
						{
							Availability{visibility:true,readonly:false,allowdownload:false}
							Email{visibility:true,readonly:false,allowdownload:false}
							ZC_Record_Type{visibility:false}
							Joining_Date{visibility:true,readonly:false,allowdownload:false}
							Technician_ID{visibility:true,readonly:false,allowdownload:false}
							Phone_Number{visibility:true,readonly:false,allowdownload:false}
							Section{visibility:false,readonly:false,allowdownload:false}
							Skill{visibility:true,readonly:false,allowdownload:false}
							Remarks{visibility:true,readonly:false,allowdownload:false}
							Active_Status{visibility:true,readonly:false,allowdownload:false}
							Team{visibility:true,readonly:false,allowdownload:false}
							Technician_Name{visibility:true,readonly:false,allowdownload:false}
							Assigned_Area_Locality{visibility:true,readonly:false,allowdownload:false}
							Assigned_District{visibility:true,readonly:false,allowdownload:false}
						}
					}
					Feedback
					{
						allFieldsVisible= true 
					}
					Water_Asset_Location
					{
						enabled= Viewall 
						allFieldsVisible= true 
						ReportPermissions
						{
							Water_Asset_Register={"View"}
						}
					}
					Area_Locality_Master
					{
