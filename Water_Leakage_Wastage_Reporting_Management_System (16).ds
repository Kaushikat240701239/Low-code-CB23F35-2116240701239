			roles
			{
				"Admin"
				{
					description = "User belonging to this role can access data of all other users.Manages application settings, user access, role permissions, forms, reports, dashboards, and overall system configuration."
					"Supervisor"
					{
						description = "Reviews water leakage and water wastage and public water complaints and assigns technicians monitors repair progress and verifies completed repairs."
						"Technician"
						{
							description = "Inspects assigned water complaints, performs repairs, records materials used, uploads repair evidence, and updates repair status."
						}
					}
					"Citizen"
					{
						description = "Registers water leakage, water wastage, and public water supply complaints tracks complaint status,views repair updates and submits feedback after resolution."
					}
				}
			}
