		form Materials_Used
		{
			displayname = "Materials Used"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Material_Name
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Quantity
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Unit_Cost
			(
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Total_Cost
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Quantity * input.Unit_Cost
    						visibility = false
    			)
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Repair_Resolution
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Repair_ID
			(
    			type = autonumber
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Issue
			(
				type = picklist	
				values  = Water_Issue_Report.ID
    			displayformat = [Issue_Title]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Technician
			(
				type = picklist	
				values  = Technician.ID
    			displayformat = [" " + Technician_Name.first_name + " " + Technician_Name.last_name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Repair_Start_Time
			(
    			type = datetime
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Repair_End_Time
			(
    			type = datetime
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Repair_Type
			(
				type = picklist
				maxchar = 100
				values = {"Pipeline Repair","Leakage Repair","Valve Replacement","Pipe Replacement","Tank Repair","Pump Repair","Meter Repair","Cleaning","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Action_Taken
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Repair_Cost
			(
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Water_Loss_Estimate
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
			Repair_Photo
			(
    			type = image
				source  = file
    			file count = 10
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Inspection_Result
			(
				type = picklist
				maxchar = 100
				values = {"Passed","Failed","Requires Further Work"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Repair_Status
			(
				type = picklist
				maxchar = 100
				values = {"Not Started","In Progress","On Hold","Completed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Verified_By
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Verification_Status
			(
				type = picklist
				maxchar = 100
				values = {"Pending","Approved","Rework Required"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Remarks
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Materials_Used
			(
				type = grid
				displayname = "Materials Used"
				values  = Materials_Used.ID
	 			row = 2
	 			column = 1   
				width = medium
			)
			Inspection_Checklist
			(
				type = grid
				displayname = "Inspection Checklist"
				values  = Inspection_Checklist.ID
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Technician
		{
			success message = "Technician Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Technician_ID
			(
    			type = autonumber
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Technician_Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Phone_Number
			(
    			type = phonenumber
				displayname = "Phone"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Team
			(
				type = picklist	
				values  = Maintenance_Team.ID
    			displayformat = [Team_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Skill
			(
				type = picklist
				maxchar = 100
				values = {"Pipeline Repair","Tap Repair","Pump Maintenance","Valve Repair","Water Tank  Maintenance","General"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Assigned_District
			(
				type = picklist
				maxchar = 100
				values = {"Ariyalur","Chengalpattu","Chennai","Coimbatore","Cuddalore","Dharmapuri","Dindigul","Erode","Kallakurichi","Kancheepuram","Kanniyakumari","Karur","Krishnagiri","Madurai","Mayiladuthurai","Nagapattinam","Namakkal","Perambalur","Pudukkottai","Ramanathapuram","Ranipet","Salem","Sivaganga","Tenkasi","Thanjavur","Theni","Thoothukudi","Tiruchirappalli","Tirunelveli","Tirupattur","Tiruppur","Tiruvallur","Tiruvannamalai","Tiruvarur","Vellore","Viluppuram","Virudhunagar","The Nilgiris"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Assigned_Area_Locality
			(
				type = picklist	
				values  = Area_Locality_Master.ID
    			displayformat = [Locality_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Availability
			(
				type = picklist
				maxchar = 100
				values = {"Available","Busy","On Leave","Unavailable"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Active_Status
			(
				type = picklist
				maxchar = 100
				values = {"Active","Inactive"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Joining_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Remarks
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Water_Asset_Location
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Asset_ID
			(
    			type = autonumber
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Asset_Name
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Asset_Type
			(
				type = picklist
				maxchar = 100
				values = {"Pipeline","Public Tap","Water Tank","Valve","Pump","Borewell","Water Meter","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have District
			(
				type = picklist
				maxchar = 100
				values = {"Ariyalur","Chengalpattu","Chennai","Coimbatore","Cuddalore","Dharmapuri","Dindigul","Erode","Kallakurichi","Kancheepuram","Kanniyakumari","Karur","Krishnagiri","Madurai","Mayiladuthurai","Nagapattinam","Namakkal","Perambalur","Pudukkottai","Ramanathapuram","Ranipet","Salem","Sivaganga","Tenkasi","Thanjavur","Theni","Thoothukudi","Tiruchirappalli","Tirunelveli","Tirupattur","Tiruppur","Tiruvallur","Tiruvannamalai","Tiruvarur","Vellore","Viluppuram","Virudhunagar","The Nilgiris"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Area_Locality
			(
				type = picklist	
				values  = Area_Locality_Master.ID
    			displayformat = [Locality_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Street_Address
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Installation_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Asset_Status
			(
				type = picklist
				maxchar = 100
				values = {"Operational","Damaged","Under Maintenance","Inactive"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Last_Inspection_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Next_Inspection_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Responsible_Team
			(
				type = picklist	
				values  = Maintenance_Team.ID
    			displayformat = [Team_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Remarks
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Water_Issue_Report
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Issue_ID
			(
    			type = autonumber
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Citizen
			(
				type = picklist	
				values  = Citizen_Registration.ID
    			displayformat = [" " + Full_Name.first_name + " " + Full_Name.last_name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Issue_Title
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Issue_Type
			(
				type = picklist
				maxchar = 100
				values = {"Water Pipe Leakage","Pipeline Burst","Public Tap Leakage","Overflowing Water Tank","Water Wastage","Broken Water Valve","Blocked Water Pipeline","Low Water Supply","No Water Supply","Contaminated Water","Damaged Water Meter","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			District
			(
				type = picklist
				maxchar = 100
				values = {"Ariyalur","Chengalpattu","Chennai","Coimbatore","Cuddalore","Dharmapuri","Dindigul","Erode","Kallakurichi","Kancheepuram","Kanniyakumari","Karur","Krishnagiri","Madurai","Mayiladuthurai","Nagapattinam","Namakkal","Perambalur","Pudukkottai","Ramanathapuram","Ranipet","Salem","Sivaganga","Tenkasi","Thanjavur","Theni","Thoothukudi","Tiruchirappalli","Tirunelveli","Tirupattur","Tiruppur","Tiruvallur","Tiruvannamalai","Tiruvarur","Vellore","Viluppuram","Virudhunagar","The Nilgiris"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Area_Locality
			(
				type = picklist	
				values  = Area_Locality_Master.ID
    			displayformat = [Locality_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Street_Address
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Pincode
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Landmark
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Issue_Photo
			(
    			type = image
				source  = file
    			file count = 10
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Report_Date
			(
    			type = date
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Report_Time
			(
    			type = time
				initial value = "${zoho.currenttime}"	
				timedisplayoptions = "hh:mm" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			Severity
			(
				type = picklist
				maxchar = 100
				values = {"Minor","Moderate","Major","Critical"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Priority
			(
				type = picklist
				maxchar = 100
				values = {"Low","Medium","High","Critical"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Under Review","Approved","Assigned","In Progress","On Hold","Resolved","Rejected","Closed","submitted"}
				initial value = "submitted"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Assigned_Team
			(
				type = picklist	
				values  = Maintenance_Team.ID
    			displayformat = [Team_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Technician
			(
				type = picklist	
				values  = Technician.ID
    			displayformat = [" " + Technician_Name.first_name + " " + Technician_Name.last_name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Expected_Resolution_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Resolution_Notes
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Evidence_Subform
			(
				type = grid
				displayname = "Evidence Subform"
				values  = Evidence_Subform.ID
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		kanban priority_report
		{
			displayName = "priority report"
			show all rows from Water_Issue_Report    
			(
				Issue_ID
				Citizen
				Issue_Title
				Issue_Type
				Description
				District
				Area_Locality
				Street_Address
				Pincode
				Landmark
				Issue_Photo
				Report_Date
				Report_Time
				Severity
				Priority
				Status
				Assigned_Team
				Technician
				Expected_Resolution_Date
				Resolution_Notes
			)
			options
			(
	 			display field = Priority
	 		)
		}
		default list Area_Locality_Master_Report
		{
			displayName = "Area_Locality_Master Report"
			show all rows from Area_Locality_Master    
			(
				Locality_ID
